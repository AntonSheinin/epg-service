DATABASE_URL=postgresql://epg:change-me@postgres:5432/epg
POSTGRES_DB=epg
POSTGRES_USER=epg
POSTGRES_PASSWORD=change-me

EPG_SOURCES_FILE=config/epg_sources.toml
EPG_FETCH_CRON=0 3 * * *
EPG_FETCH_MISFIRE_GRACE_SEC=3600
EPG_CHANNELS_CHUNK_SIZE=1000
EPG_PROGRAMS_CHUNK_SIZE=4000
